  <property name="styleSheet">
   <string notr="true">#btnBuscar, #btnGuardar, #btnActualizar, #btnEliminar, #btnLimpiar {
    background-color: white;
    color: black;
    border: 2px solid #444;
    border-radius: 10px;
    font-weight: bold;
    padding: 8px 14px;
}

#btnBuscar:hover, #btnGuardar:hover, #btnActualizar:hover, #btnEliminar:hover, #btnLimpiar:hover {
    background-color: #f2f2f2;
}

#btnBuscar:pressed, #btnGuardar:pressed, #btnActualizar:pressed, #btnEliminar:pressed, #btnLimpiar:pressed {
    background-color: #e6e6e6;
}
</string>
